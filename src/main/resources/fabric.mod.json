{
	"schemaVersion": 1,
	"id": "koi-atelier",
	"version": "${version}",
	"name": "Koi Atelier",
	"description": "Client-side cosmetics and HUD: orbiting koi, particle aura and trail, pet, halo, cape, wings, coordinates, minimap, durability warning, zoom and fullbright. Only you can see the cosmetics.",
	"authors": [
		"hamnnnyy"
	],
	"contact": {
		"homepage": "https://github.com/hamnnnyy/koi-atelier",
		"sources": "https://github.com/hamnnnyy/koi-atelier",
		"issues": "https://github.com/hamnnnyy/koi-atelier/issues"
	},
	"license": "MIT",
	"icon": "assets/koi-atelier/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.hamnnnyy.koiatelier.KoiAtelierClient"
		],
		"modmenu": [
			"io.github.hamnnnyy.koiatelier.KoiModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"mixins": [
		{
			"config": "koi-atelier.client.mixins.json",
			"environment": "client"
		}
	]
}
